{
  "name": "@reservo/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts | pino-pretty --messageKey message --ignore severity",
    "start": "NODE_ENV=production bun src/index.ts",
    "prisma:generate": "bun --env-file=.env --bun prisma generate",
    "prisma:migrate": "bun --env-file=.env --bun prisma migrate dev",
    "prisma:migrate:deploy": "bun --env-file=.env --bun prisma migrate deploy",
    "prisma:studio": "bun --env-file=.env --bun prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format",
    "fix": "bun run lint:fix && bun run format:fix"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.6.23",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.200.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/instrumentation": "^7.8.0",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.22",
    "elysia": "^1.4.30",
    "exact-mirror": "^0.2.7",
    "pino": "^10.3.1",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.4.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-helpers": "^2.0.2",
    "globals": "^16.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "prisma": "^7.10.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.66.0"
  }
}
